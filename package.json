{
  "name": "media-meta-manager",
  "version": "0.1.0",
  "private": true,
  "description": "Obsidian plugin for importing Discogs metadata",
  "main": "main.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild main.ts --bundle --external:obsidian --external:electron --format=cjs --platform=node --outfile=main.js --sourcemap",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
